@echo off
title Check Local Server Status
cd /d "%~dp0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "& { Write-Host '=== BPA Stock Local Server Status ===' -ForegroundColor Cyan; $portOpen = Test-NetConnection -ComputerName 127.0.0.1 -Port 8080 -WarningAction SilentlyContinue; if ($portOpen.TcpTestSucceeded) { Write-Host '[STATUS] Local Server is RUNNING on Port 8080!' -ForegroundColor Green; try { $res = Invoke-RestMethod -Uri 'http://127.0.0.1:8080/health' -TimeoutSec 3; Write-Host ('[HEALTH] Status: ' + $res.status + ' | SDK Configured: ' + $res.line_sdk_configured) -ForegroundColor Green } catch { Write-Host '[HEALTH] Port open but health endpoint not responding.' -ForegroundColor Yellow } } else { Write-Host '[STATUS] Local Server is NOT running.' -ForegroundColor Red }; $cfRunning = Get-Process cloudflared -ErrorAction SilentlyContinue; if ($cfRunning) { Write-Host ('[TUNNEL] Cloudflare Tunnel is RUNNING (PID: ' + $cfRunning.Id + ')') -ForegroundColor Green } else { Write-Host '[TUNNEL] Cloudflare Tunnel is NOT running.' -ForegroundColor Yellow }; $autoStart = [System.IO.Path]::Combine($env:APPDATA, 'Microsoft\Windows\Start Menu\Programs\Startup\TwStockBpaServer.lnk'); if (Test-Path $autoStart) { Write-Host '[AUTOSTART] Enabled (will start automatically on boot)' -ForegroundColor Green } else { Write-Host '[AUTOSTART] Disabled' -ForegroundColor Gray }; Write-Host '=====================================' -ForegroundColor Cyan }"
echo.
pause
