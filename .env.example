# LINE Developers Console 憑證設定
# 前往 https://developers.line.biz/ 登入建立 Messaging API Channel
LINE_CHANNEL_SECRET=請替換為你的_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=請替換為你的_channel_access_token
PORT=8080

# ── Cloudflare Worker 本地備援全自動同步設定 (解法 A) ──
# 填入以下兩筆設定後，每次啟動「啟動本地備援.bat」，腳本將自動同步最新穿透網址，免手動貼上！
# 1. 帳號 ID (Account ID)：在 Cloudflare Dashboard 右側側邊欄或網址列可看到
CF_ACCOUNT_ID=你的_Cloudflare_Account_ID

# 2. API Token：至 https://dash.cloudflare.com/profile/api-tokens 建立 (選「Edit Cloudflare Workers」模板)
CF_API_TOKEN=你的_Cloudflare_API_Token

# 3. Worker 服務名稱 (預設為 tw-stock-bpa-router)
CF_WORKER_NAME=tw-stock-bpa-router
